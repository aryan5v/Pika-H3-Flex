+def _enable_emu_linears(module: nn.Module) -> None:
+    # The ctypes call is opaque to torch.compile, so it is excluded from tracing (a graph break per GEMM).
+    emu_forward = torch._dynamo.disable(_emu_linear_forward)
+    for submodule in module.modules():
+        if isinstance(submodule, nn.Linear):
+            submodule.forward = types.MethodType(emu_forward, submodule)
+
