+# Faster FP32 video decode. Three environment knobs, all keeping the decoder in float32:
+#   H3_VAE_EMU_GEMM=1     run the decoder's nn.Linear GEMMs through cuBLAS' FP32 emulation (see `_emu_gemm`); 0 = native.
+#   H3_VAE_TILE_BATCH=28  decode up to this many equal-shape spatial tiles of a temporal clip as one batch; 1 = serial.
+#   H3_VAE_COMPILE=0      1 = torch.compile the tile decoder (pointwise fusion only); eager fallback on any failure.
+# Every path falls back to the native FP32 computation automatically when it is unavailable.
+_EMU_GEMM_ENV = "H3_VAE_EMU_GEMM"
+_TILE_BATCH_ENV = "H3_VAE_TILE_BATCH"
+_COMPILE_ENV = "H3_VAE_COMPILE"
+_EMU_GEMM_DEFAULT = "1"
+_TILE_BATCH_DEFAULT = 28
+_COMPILE_DEFAULT = "0"
+
+# cuBLAS constants (cublas_api.h / library_types.h, CUDA 12.9).
+_CUBLAS_LIBRARY = "libcublas.so.12"
+_CUBLAS_STATUS_SUCCESS = 0
+_CUBLAS_OP_N, _CUBLAS_OP_T = 0, 1
+_CUBLAS_DEFAULT_MATH = 0  # no TF32
+_CUBLAS_EMULATION_STRATEGY_EAGER = 2
+_CUBLAS_COMPUTE_32F_EMULATED_16BFX9 = 78
+_CUBLAS_GEMM_DEFAULT = -1
+_CUDA_R_32F = 0
+_EMU_MIN_DIM = 128
+
+_EMU_STATE = {"lib": None, "failed": False, "handles": {}, "warned": False}
+_EMU_ALPHA = ctypes.c_float(1.0)
+_EMU_BETA = ctypes.c_float(0.0)
+
+
+def _env_flag(name: str, default: str) -> bool:
+    value = os.environ.get(name, default).strip()
+    if value not in ("0", "1"):
+        raise ValueError(f"{name} must be 0 or 1, got {value!r}")
+    return value == "1"
+
+
+def _env_positive_int(name: str, default: int) -> int:
+    value = os.environ.get(name, str(default)).strip()
+    try:
+        parsed = int(value)
+    except ValueError:
+        parsed = 0
+    if parsed < 1:
+        raise ValueError(f"{name} must be a positive integer, got {value!r}")
+    return parsed
+
+
+def _emu_disable(reason: str) -> None:
+    _EMU_STATE["failed"] = True
+    if not _EMU_STATE["warned"]:
+        _EMU_STATE["warned"] = True
+        logger.warning(f"Emulated FP32 GEMM unavailable ({reason}); the VAE decoder uses native FP32 GEMMs.")
+
+
+def _load_cublas():
+    if _EMU_STATE["lib"] is not None or _EMU_STATE["failed"]:
+        return _EMU_STATE["lib"]
+    try:
+        # Resolves to the cuBLAS that PyTorch already loaded; no extra dependency.
+        lib = ctypes.CDLL(_CUBLAS_LIBRARY)
+        lib.cublasCreate_v2.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
+        lib.cublasDestroy_v2.argtypes = [ctypes.c_void_p]
+        lib.cublasSetStream_v2.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
+        lib.cublasSetMathMode.argtypes = [ctypes.c_void_p, ctypes.c_int]
+        lib.cublasSetEmulationStrategy.argtypes = [ctypes.c_void_p, ctypes.c_int]
+        lib.cublasGemmEx.argtypes = [
+            ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int,
+            ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
+            ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
+            ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int,
+        ]
+        for name in ("cublasCreate_v2", "cublasDestroy_v2", "cublasSetStream_v2", "cublasSetMathMode",
+                     "cublasSetEmulationStrategy", "cublasGemmEx"):
+            getattr(lib, name).restype = ctypes.c_int
+    except (OSError, AttributeError) as error:
+        _emu_disable(str(error))
+        return None
+    _EMU_STATE["lib"] = lib
+    return lib
+
+
+def _emu_handle(device: torch.device):
+    """Return `(lib, handle)` for `device`, creating one cuBLAS handle per device; None if unavailable."""
+    lib = _load_cublas()
+    if lib is None:
+        return None
+    index = device.index if device.index is not None else torch.cuda.current_device()
+    handle = _EMU_STATE["handles"].get(index)
+    if handle is not None:
+        return lib, handle
+    handle = ctypes.c_void_p()
+    with torch.cuda.device(index):
+        if lib.cublasCreate_v2(ctypes.byref(handle)) != _CUBLAS_STATUS_SUCCESS:
+            _emu_disable("cublasCreate failed")
+            return None
+        if (
+            lib.cublasSetMathMode(handle, _CUBLAS_DEFAULT_MATH) != _CUBLAS_STATUS_SUCCESS
+            or lib.cublasSetEmulationStrategy(handle, _CUBLAS_EMULATION_STRATEGY_EAGER) != _CUBLAS_STATUS_SUCCESS
+        ):
+            lib.cublasDestroy_v2(handle)
+            _emu_disable("cuBLAS emulation settings rejected")
+            return None
+    _EMU_STATE["handles"][index] = handle
+    return lib, handle
+
