+def _emu_gemm(x2d: torch.Tensor, weight: torch.Tensor) -> torch.Tensor | None:
+    r"""
+    `F.linear(x2d, weight)` without bias as an FP32 GEMM with compute type `CUBLAS_COMPUTE_32F_EMULATED_16BFX9`.
+
+    cuBLAS splits every FP32 operand into three BF16 values whose sum is the FP32 value exactly (8 + 8 + 8 significand
+    bits), multiplies the nine pairs exactly on the tensor cores and accumulates in FP32. Operands, accumulators and the
+    result stay FP32, TF32 is never used, and only the summation order differs from the native SGEMM (measured against
+    a float64 reference it is more accurate than the native SIMT SGEMM on the decoder's shapes).
+
+    cuBLAS is column-major: the row-major `weight` (N, K) is the column-major (K, N) matrix, passed transposed with
+    lda = K; the row-major `x2d` (M, K) is the column-major (K, M) operand with ldb = K; the column-major (N, M) result
+    is the row-major `out` (M, N) with ldc = N. Returns None when the GEMM cannot run, so the caller falls back.
+    """
+    state = _emu_handle(x2d.device)
+    if state is None:
+        return None
+    lib, handle = state
+    if lib.cublasSetStream_v2(handle, torch.cuda.current_stream(x2d.device).cuda_stream) != _CUBLAS_STATUS_SUCCESS:
+        return None
+    m, k = x2d.shape
+    n = weight.shape[0]
+    out = torch.empty((m, n), dtype=torch.float32, device=x2d.device)
+    status = lib.cublasGemmEx(
+        handle, _CUBLAS_OP_T, _CUBLAS_OP_N, n, m, k,
+        ctypes.byref(_EMU_ALPHA),
+        weight.data_ptr(), _CUDA_R_32F, k,
+        x2d.data_ptr(), _CUDA_R_32F, k,
+        ctypes.byref(_EMU_BETA),
+        out.data_ptr(), _CUDA_R_32F, n,
+        _CUBLAS_COMPUTE_32F_EMULATED_16BFX9, _CUBLAS_GEMM_DEFAULT,
+    )
+    if status != _CUBLAS_STATUS_SUCCESS:
+        _emu_disable(f"cublasGemmEx status {status}")
+        return None
+    return out
 
 
+def _emu_linear_forward(self: nn.Linear, x: torch.Tensor) -> torch.Tensor:
+    """`nn.Linear.forward` that uses `_emu_gemm` for large contiguous FP32 CUDA inputs and `F.linear` otherwise."""
+    weight = self.weight
+    out_features, in_features = weight.shape
+    if (
+        not _EMU_STATE["failed"]
+        and not (torch.is_grad_enabled() and (x.requires_grad or weight.requires_grad))  # ctypes GEMM has no autograd
+        and x.is_cuda
+        and x.dtype == torch.float32
+        and weight.dtype == torch.float32
+        and x.is_contiguous()
+        and weight.is_contiguous()
+        and x.shape[-1] == in_features
+        and x.numel() // in_features >= 8
+        and min(out_features, in_features) >= _EMU_MIN_DIM
+    ):
+        out = _emu_gemm(x.view(-1, in_features), weight)
+        if out is not None:
+            if self.bias is not None:
+                out = out + self.bias
+            return out.view(*x.shape[:-1], out_features)
+    return F.linear(x, weight, self.bias)
+
