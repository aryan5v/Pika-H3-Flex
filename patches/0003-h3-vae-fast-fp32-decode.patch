+    def _decode_tiles(self, tiles: list[torch.Tensor]) -> list[torch.Tensor]:
+        r"""
+        Decode spatial tiles, batching up to `H3_VAE_TILE_BATCH` tiles of equal shape into one decoder call.
+
+        Every tile is an independent ViT document whose positions depend only on its own grid, so concatenating tiles
+        on the batch axis is the same computation with larger GEMMs. Results are returned in input order.
+        """
+        max_batch = _env_positive_int(_TILE_BATCH_ENV, _TILE_BATCH_DEFAULT)
+        if max_batch == 1:
+            return [self.decoder(tile) for tile in tiles]
+        order = sorted(range(len(tiles)), key=lambda index: tuple(tiles[index].shape))
+        decoded = [None] * len(tiles)
+        start = 0
+        while start < len(order):
+            shape = tuple(tiles[order[start]].shape)
+            stop = start + 1
+            while stop < len(order) and stop - start < max_batch and tuple(tiles[order[stop]].shape) == shape:
+                stop += 1
+            group = order[start:stop]
+            for index, output in zip(group, self._decode_tile_group([tiles[index] for index in group])):
+                decoded[index] = output
+            start = stop
+        return decoded
 
+    def _decode_tile_group(self, group: list[torch.Tensor]) -> list[torch.Tensor]:
+        """Decode equal-shape tiles as one batch; on CUDA out-of-memory, retry in halves down to single tiles."""
+        try:
+            outputs = self.decoder(torch.cat(group, dim=0))
+        except torch.cuda.OutOfMemoryError:
+            if len(group) == 1:
+                raise
+            torch.cuda.empty_cache()
+            half = len(group) // 2
+            return self._decode_tile_group(group[:half]) + self._decode_tile_group(group[half:])
+        return list(outputs.split([tile.shape[0] for tile in group], dim=0))
+
